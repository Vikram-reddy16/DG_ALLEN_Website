NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (applications are saved with this key). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Shared with the dashboard; >= 16 chars. Protects /api/revalidate.
REVALIDATE_SECRET=
# Cloudflare Turnstile (optional locally; set both in production)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
